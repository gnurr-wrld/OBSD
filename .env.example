# ============================================================================
# OBSESSED LTD (OBSD) — ENVIRONMENT CONFIGURATION (.env.local)
# Copy this file to .env.local and paste your keys from Yoco & Medusa
# NEVER commit .env.local or raw account passwords to Git!
# ============================================================================

# 1. Yoco Online Checkout API Keys
# Get these from: https://portal.yoco.com -> Selling Online -> Payment Gateway / API Keys
NEXT_PUBLIC_YOCO_PUBLIC_KEY=pk_test_replace_with_your_yoco_public_key
YOCO_SECRET_KEY=sk_test_replace_with_your_yoco_secret_key
YOCO_WEBHOOK_SECRET=whsec_replace_with_your_yoco_webhook_secret

# 2. Server-Side Cart & Order HMAC Signing Secret (Generate a 32+ char random hex string)
OBSD_CART_HMAC_SECRET=obsd_forest_sanctuary_hmac_secret_2026_key

# 3. Medusa v2 Backend Configuration
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_test_obsd_sanctuary
NEXT_PUBLIC_ENABLE_LIVE_MEDUSA=false
